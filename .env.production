# Local docker-compose stack (ChamboMetadataTaggerBackend/docker-compose.yml) with Keycloak.
VITE_API_URL=http://localhost:8080
VITE_KEYCLOAK_ENABLED=true
VITE_KEYCLOAK_URL=http://localhost:8081
VITE_KEYCLOAK_REALM=chambo
VITE_KEYCLOAK_CLIENT_ID=chambo-frontend
VITE_KEYCLOAK_REDIRECT_URI=http://localhost:3000/
VITE_MSAL_ENABLED=false
APIM_TARGET_URL=https://int.apiqa.worldbank.org/metadata/

